<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Yemma Store</title>
  <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;700&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: 'Roboto', sans-serif;
      background: #fff8f0;
      color: #333;
      line-height: 1.6;
    }
    header {
      background: linear-gradient(to right, #f9c06b, #ffdbb5);
      padding: 2rem;
      text-align: center;
    }
    header h1 {
      font-size: 2.5rem;
      color: #3b2f2f;
    }
    header p {
      font-size: 1.2rem;
      margin-top: 0.5rem;
    }
    .products {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 2rem;
      padding: 2rem;
    }
    .product {
      background: white;
      border-radius: 15px;
      padding: 1rem;
      box-shadow: 0 4px 6px rgba(0,0,0,0.1);
      text-align: center;
    }
    .product img {
      max-width: 100%;
      border-radius: 10px;
    }
    .product h2 {
      margin: 1rem 0 0.5rem;
      font-size: 1.2rem;
    }
    .product p {
      margin-bottom: 0.5rem;
    }
    .product button {
      padding: 0.5rem 1rem;
      background: #ff944d;
      color: white;
      border: none;
      border-radius: 8px;
      cursor: pointer;
    }
    .contact {
      background: #ffe5cc;
      padding: 2rem;
      text-align: center;
    }
    .contact h2 {
      margin-bottom: 1rem;
    }
    .contact form input,
    .contact form textarea {
      width: 100%;
      padding: 0.75rem;
      margin: 0.5rem 0;
      border-radius: 10px;
      border: 1px solid #ccc;
    }
    .contact form button {
      background: #e67300;
      color: white;
      padding: 0.75rem 2rem;
      border: none;
      border-radius: 8px;
      cursor: pointer;
    }
    footer {
      background: #3b2f2f;
      color: white;
      text-align: center;
      padding: 1rem;
    }
  </style>
</head>
<body>
  <header>
    <h1>Yemma Store</h1>
    <p>Des produits algériens qui ravivent vos souvenirs d'enfance</p>
  </header>

  <section class="products">
    <div class="product">
      <img src="https://via.placeholder.com/250x150" alt="Produit 1">
      <h2>Produit 1</h2>
      <p>5,99 €</p>
      <button>Commander</button>
    </div>
    <div class="product">
      <img src="https://via.placeholder.com/250x150" alt="Produit 2">
      <h2>Produit 2</h2>
      <p>8,50 €</p>
      <button>Commander</button>
    </div>
    <!-- Ajoute d'autres produits ici -->
  </section>

  <section class="contact">
    <h2>Contactez-nous</h2>
    <form action="mailto:glassaction95100@gmail.com" method="post" enctype="text/plain">
      <input type="text" name="name" placeholder="Votre nom" required>
      <input type="email" name="email" placeholder="Votre email" required>
      <textarea name="message" rows="4" placeholder="Votre message"></textarea>
      <button type="submit">Envoyer</button>
    </form>
  </section>

  <footer>
    <p>&copy; 2025 Yemma Store. Tous droits réservés.</p>
  </footer>
</body>
</html>
